{
  "name": "deepseek-compatible-paperclip-adapter",
  "version": "2026.10.22",
  "description": "DeepSeek adapter for Paperclip using the OpenAI-compatible chat completions API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgebeserra/deepseek-compatible-paperclip-adapter"
  },
  "keywords": [
    "paperclip",
    "deepseek",
    "ai-agent",
    "adapter",
    "orchestration"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@paperclipai/adapter-utils": "2026.1005.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24.11.0"
  }
}
